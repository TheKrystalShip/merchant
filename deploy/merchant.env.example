# Copy to ~/.config/merchant/merchant.env and chmod 600. Never commit the real file.

# From https://discord.com/developers/applications → your app → Bot → Reset Token.
MERCHANT_TOKEN=paste-the-bot-token-here

# MERCHANT_DB is set by the unit (~/.local/state/merchant/merchant.db). Override it here only with an
# absolute path that is also listed in the unit's ReadWritePaths.

# How often every subscribed feed is fetched, in minutes. Clamped to 5–720; 30 is plenty.
MERCHANT_SWEEP_MINUTES=30

# Sent on every outbound request. CheapShark rejects a generic agent outright.
MERCHANT_USER_AGENT=merchant/1.0 (Discord game-deal announcer)

# Set to a server id while developing: guild commands register instantly, global ones take an hour.
#MERCHANT_DEV_GUILD=000000000000000000

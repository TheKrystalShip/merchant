# Copy to ~/.config/merchant/merchant.env and chmod 600. Never commit the real file.
#
# This file is for the token and nothing else. Everything merchant does — which feeds exist, where
# they come from, how often it sweeps — lives in ~/.config/merchant/appsettings.json.

# From https://discord.com/developers/applications → your app → Bot → Reset Token.
MERCHANT_TOKEN=paste-the-bot-token-here

# Where the settings file is read from. It defaults to ~/.config/merchant/appsettings.json, which
# is where install.sh puts it; set this only if the catalog needs to live somewhere else.
#MERCHANT_CONFIG=/srv/merchant/appsettings.json

# Each setting in appsettings.json can be overridden here, and the override wins. The file is the
# better place for all of them; these exist because a unit file and a container already pass them.
#MERCHANT_DB=/absolute/path/merchant.db      # also add it to the unit's ReadWritePaths
                                            # default: ~/.local/state/merchant/merchant.db
#MERCHANT_SWEEP_MINUTES=30
#MERCHANT_USER_AGENT=merchant/1.0 (Discord game-deal announcer)
#MERCHANT_DEV_GUILD=000000000000000000

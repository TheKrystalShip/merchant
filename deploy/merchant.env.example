# Copy to ~/.config/merchant/merchant.env and chmod 600. Never commit the real file.
#
# This file is for the token and nothing else. Everything merchant does — which feeds exist, where
# they come from, how often it sweeps — lives in ~/.config/merchant/appsettings.json.

# From https://discord.com/developers/applications → your app → Bot → Reset Token.
MERCHANT_TOKEN=paste-the-bot-token-here

# Where the settings file is read from. It defaults to ~/.config/merchant/appsettings.json — the
# directory the unit creates, and the one install.sh writes into. Set this only if the catalog
# needs to live somewhere else, and write the file there yourself: the unit can read a settings
# file anywhere and can only create one in the directory it made.
#MERCHANT_CONFIG=/srv/merchant/appsettings.json

# Four of the settings in appsettings.json can also be given here, and the value here wins. These
# four and no others: the feeds are the catalog and live only in the file. It is the better place
# for these as well — they exist because a unit file and a container already pass them.
#MERCHANT_DB=/absolute/path/merchant.db      # the unit writes only in the directory it created,
                                            # ~/.local/state/merchant, so give it the new one
                                            # with ReadWritePaths= as well.
#MERCHANT_SWEEP_MINUTES=30
#MERCHANT_USER_AGENT=merchant/1.0 (Discord game-deal announcer)
#MERCHANT_DEV_GUILD=000000000000000000

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- merchant depends on nothing of TheKrystalShip's: Discord.Net and Microsoft.Data.Sqlite are the
       whole surface. nuget.org alone, so the repo clones and builds on a machine that has never
       held a GitHub Packages token. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
